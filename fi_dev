default partial alphanumeric_keys
xkb_symbols "basic" {
    include "fi"
    name[Group1] = "Finnish Dev";


    key <AE12> { [ slash,		backslash,	bar				 ] };
    key <AE11> { [ plus,		question					 ] };

    key <AD11> { [ bracketleft,		braceleft					 ] };
    key <AD12> { [ bracketright,	braceright					 ] };

key <CAPS> {
    type[Group1] = "FOUR_LEVEL",
    symbols[Group1] = [ Escape, Multi_key ],
    actions[Group1] = [
        NoAction(),
        NoAction(),
        NoAction(),
        LockMods(modifiers = Lock)
    ]
};

    key <LSGT> { [ less,		greater,	asciicircum				 ] };
};
